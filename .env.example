# Memoria Environment Configuration
# Copy this file to .env and fill in your API keys

# ===========================================
# AI Provider API Keys (Required)
# ===========================================

# Fireworks AI (recommended - supports multiple models via routing)
# Get your key at: https://fireworks.ai/api-keys
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Or use OpenAI directly
# OPENAI_API_KEY=your_openai_key_here

# Or use Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_key_here

# ===========================================
# Optional: Custom Model Configuration
# ===========================================

# Default model to use
# MODEL=accounts/fireworks/routers/kimi-k2p5-turbo

# Optional: Custom base URL for OpenAI-compatible endpoints
# OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1

# Optional: Enable verbose logging
# VERBOSE=false

# Optional: Max tokens per request
# MAX_TOKENS=8192
