#!/bin/sh
# Memoria local checks. No upstream services, signing identities, or account gates.
# Full-suite failures and native acceptance gaps are tracked in docs/WORKSPACE-PRODUCT-VERIFICATION.md.
set -eu
pnpm build
pnpm test:memoria
PYTHON="${MEMORIA_TEST_PYTHON:-python3}"
"$PYTHON" -m unittest discover -s src-tauri/resources/memory -p test_workspace_product.py
"$PYTHON" -m unittest discover -s src-tauri/resources/memory -p test_engine.py
